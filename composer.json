{
    "name": "misaf/vendra-newsletter",
    "description": "Tenant-aware newsletter publishing and subscriber management for Vendra",
    "keywords": [
        "laravel",
        "filamentphp",
        "misaf",
        "vendra",
        "newsletter"
    ],
    "homepage": "https://github.com/misaf/vendra-newsletter",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.4",
        "misaf/filament-jalali": "^5.1.4",
        "misaf/vendra-support": "self.version",
        "spatie/laravel-package-tools": "^1.93.1"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraNewsletter\\": "src/",
            "Misaf\\VendraNewsletter\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misaf\\VendraNewsletter\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraNewsletter\\Providers\\NewsletterServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-newsletter/issues",
        "source": "https://github.com/misaf/vendra-newsletter"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
