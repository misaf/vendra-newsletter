{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "misaf/vendra-newsletter",
  "description": "",
  "type": "vendra-module",
  "license": "MIT",
  "keywords": [
    "laravel",
    "filamentphp",
    "misaf",
    "vendra",
    "newsletter"
  ],
  "homepage": "https://github.com/misaf/vendra-newsletter",
  "support": {
    "issues": "https://github.com/misaf/vendra-newsletter/issues",
    "source": "https://github.com/misaf/vendra-newsletter"
  },
  "authors": [
    {
      "name": "Ehsan Mahmoodi",
      "email": "misaf.1990@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "filament/filament": "^4.0",
    "illuminate/support": "^11.0|^12.0",
    "misaf/vendra-tenant": "^12.0",
    "misaf/vendra-user": "dev-master",
    "spatie/laravel-translatable": "^6.12.0",
    "misaf/laravel-email-webhooks": "^1.0.0",
    "misaf/vendra-activity-log": "dev-master",
    "awcodes/filament-badgeable-column": "^3.0",
    "mokhosh/filament-jalali": "5.1",
    "spatie/laravel-sluggable": "^3.7.5",
    "spatie/laravel-package-tools": "^1.92",
    "spatie/laravel-webhook-client": "^3.4.5"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24.1",
    "larastan/larastan": "^3.9.2",
    "laravel/boost": "^2.0.6",
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.6.12",
    "nunomaduro/collision": "^8.8.3",
    "orchestra/testbench": "^10.9",
    "pestphp/pest": "^4.3.2",
    "pestphp/pest-plugin-arch": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "pestphp/pest-plugin-profanity": "^4.2.1",
    "pestphp/pest-plugin-type-coverage": "^4.0.3",
    "misaf/vendra-testing": "dev-master"
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse",
    "test": "vendor/bin/pest",
    "test-coverage": "vendor/bin/pest --coverage",
    "format": "vendor/bin/pint"
  },
  "autoload": {
    "psr-4": {
      "Misaf\\VendraNewsletter\\": "src/",
      "Misaf\\VendraNewsletter\\Tests\\": "tests/",
      "Misaf\\VendraNewsletter\\Database\\Factories\\": "database/factories/",
      "Misaf\\VendraNewsletter\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Misaf\\VendraNewsletter\\NewsletterServiceProvider",
        "Misaf\\VendraNewsletter\\NewsletterDeferredServiceProvider"
      ]
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
